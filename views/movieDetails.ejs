<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Details</title>
    <link href="/css/styles.css" rel="stylesheet">
</head>

<body>
    <%- include('partials/navbar.ejs') %>

        <main class="container">

            <!-- <form action="/search" method="GET" class="inline-form">
            <button>Back to Results</button>
        </form> -->

            <h1>
                <%= details.title %>
            </h1>

            <!-- poster -->
             <div class="r">
            <% if (details.poster_path) { %>
                <img src="https://image.tmdb.org/t/p/w500<%= details.poster_path %>" alt="<%= details.title %> poster"
                    style="max-width:250px; border-radius:6px; margin:12px 0;">
                <% } %>

                <!-- <h2>Trailer</h2> -->
                    <% if (trailer) { %>
                        <iframe width="560" height="315" src="https://www.youtube.com/embed/<%= trailer.key %>"
                            allowfullscreen>
                        </iframe>
                        <% } else { %>
                            <p>No trailer available.</p>
                            <% } %>
</div>
                    <!-- basic info -->
                    <p><strong>Release Date:</strong>
                        <%= details.release_date %>
                    </p>
                    <p><strong>Rating:</strong>
                        <%= details.vote_average %>
                    </p>
                    <p><strong>Runtime:</strong>
                        <%= details.runtime %> minutes
                    </p>
                    

                    <h2>Overview</h2>
                    <p>
                        <%= details.overview %>
                    </p>

                    <h2>Cast</h2>

                    <div class="carousel">

                        <div class="carousel-track" id="castTrack">
                            <% for (let actor of cast) { %>
                                <div class="slide">
                                    <% if (actor.profile_path) { %>
                                        <img src="https://image.tmdb.org/t/p/w200<%= actor.profile_path %>"
                                            alt="<%= actor.name %>">
                                        <% } else { %>
                                            <div class="no-img">No Image</div>
                                            <% } %>

                                                <p class="actor-name">
                                                    <%= actor.name %>
                                                </p>
                                                <p class="actor-role">
                                                    <%= actor.character %>
                                                </p>
                                </div>
                                <% } %>
                        </div>

  
                    </div>

                    

        </main>

        <%- include('partials/footer.ejs') %>
</body>

</html>

