<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results</title>
    <link href="/css/styles.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/navbar.ejs') %>

    <main class="container">
        <section class="hero">
            <h1>Search Results</h1>
            <p class="subtitle">Find a title and add it to your watchlist in one click.</p>

            <form action="/search" method="GET" class="search-form">
                <input type="text" name="query" placeholder="Try: Interstellar, Dune, Parasite" required>
                <button type="submit">Search</button>
            </form>

            <a href="/" class="pill-link">Back to Home</a>
        </section>

        <% if (query) { %>
            <p>Results for: <strong><%= query %></strong></p>
        <% } %>

        <% if (error) { %>
            <p class="error-message"><%= error %></p>
        <% } %>

        <% if (movies && movies.length > 0) { %>
            <% movies.forEach(movie => { %>
                <article class="movie-card">
                    <% if (movie.poster_path) { %>
                        <img
                          src="https://image.tmdb.org/t/p/w200<%= movie.poster_path %>"
                          alt="<%= movie.title %> poster"
                          class="movie-poster"
                        >
                    <% } else { %>
                        <div class="poster-placeholder">No Poster</div>
                    <% } %>

                    <div>
                        <h2><%= movie.title %></h2>

                        <div class="movie-meta">
                            <span>TMDB: <%= movie.id %></span>
                            <span>Release: <%= movie.release_date || 'N/A' %></span>
                            <span>Genres: <%= movie.genre_names || 'N/A' %></span>
                            <span>Rating: <%= movie.vote_average ?? 'N/A' %></span>
                        </div>

                        <p class="overview"><%= movie.overview || 'No overview available.' %></p>

                        <form action="/watchlist/add" method="POST" class="inline-form">
                            <input type="hidden" name="movie_id" value="<%= movie.id %>">
                            <input type="hidden" name="title" value="<%= movie.title %>">
                            <input type="hidden" name="poster_path" value="<%= movie.poster_path || '' %>">
                            <input type="hidden" name="release_date" value="<%= movie.release_date || '' %>">
                            <input type="hidden" name="overview" value="<%= movie.overview || '' %>">
                            <input type="hidden" name="genre" value="<%= movie.genre_names || '' %>">
                            <button type="submit">Add to Watchlist</button>
                        </form>
                    </div>
                </article>
            <% }) %>
        <% } else if (!error) { %>
            <section class="card">
                <p>No results found.</p>
            </section>
        <% } %>
    </main>

    <%- include('partials/footer.ejs') %>
</body>
</html>