<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results</title>
    <link href="/css/styles.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/navbar.ejs') %>

    <main class="container">
        <h1>Search Results</h1>
        <p><a href="/">Back to Home</a></p>

        <% if (query) { %>
            <p>Results for: <strong><%= query %></strong></p>
        <% } %>

        <% if (error) { %>
            <p class="error-message"><%= error %></p>
        <% } %>

        <% if (movies && movies.length > 0) { %>
            <% movies.forEach(movie => { %>
                <div class="movie-card">
                    <h2><%= movie.title %></h2>

                    <% if (movie.poster_path) { %>
                        <img
                          src="https://image.tmdb.org/t/p/w200<%= movie.poster_path %>"
                          alt="<%= movie.title %> poster"
                        >
                    <% } %>

                    <p><strong>TMDB ID:</strong> <%= movie.id %></p>
                    <p><strong>Release Date:</strong> <%= movie.release_date || 'N/A' %></p>
                    <p><strong>Genres:</strong> <%= movie.genre_names || 'N/A' %></p>
                    <p><strong>Rating:</strong> <%= movie.vote_average ?? 'N/A' %></p>
                    <p><%= movie.overview || 'No overview available.' %></p>
                    
                    <div class="row-btn">
                    <form action="/movie/<%= movie.id %>" method="GET">
                    <button>View Details</button>
                    </form>

                    <form action="/watchlist/add" method="POST">
                        <input type="hidden" name="movie_id" value="<%= movie.id %>">
                        <input type="hidden" name="title" value="<%= movie.title %>">
                        <input type="hidden" name="poster_path" value="<%= movie.poster_path || '' %>">
                        <input type="hidden" name="release_date" value="<%= movie.release_date || '' %>">
                        <input type="hidden" name="overview" value="<%= movie.overview || '' %>">
                        <input type="hidden" name="genre" value="<%= movie.genre_names || '' %>">
                        <button type="submit">Add to Watchlist</button>
                    </form>
                    </div>
                </div>
            <% }) %>
        <% } else if (!error) { %>
            <p>No results found.</p>
        <% } %>
    </main>

    <%- include('partials/footer.ejs') %>
</body>
</html>