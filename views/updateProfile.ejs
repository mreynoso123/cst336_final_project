<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>
    <link href="/css/styles.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/navbar.ejs') %>

    <div class="container">
        <h1>Update Profile</h1>

        <% if (error) { %>
            <p class="error-message"><%= error %></p>
        <% } %>

        <div class="card">
            <h2>Account</h2>

            <form action="/updateProfile" method="POST" class="stack-form">
                <input type="hidden" name="action" value="updateUser">

                <label for="userName">Username:</label>
                <input
                    id="userName"
                    type="text"
                    name="userName"
                    value="<%= userInfo.userName %>"
                    required
                >

                <label for="password">New Password:</label>
                <input
                    id="password"
                    type="password"
                    name="password"
                    placeholder="Enter new password"
                    required
                >

                <button type="submit">Update Profile</button>
            </form>
        </div>

        <div class="card">
            <h2>Edit Watchlist Movies</h2>
        
            <% if (watchlistInfo.length === 0) { %>
                <p class="muted">No movies found in your watchlist.</p>
            <% } %>
        
            <% for (let movie of watchlistInfo) { %>
                <div class="edit-movie-card">
                    <form action="/updateProfile" method="POST" class="edit-movie-form">
                        <input type="hidden" name="action" value="updateMovie">
                        <input type="hidden" name="watchlistId" value="<%= movie.watchlistId %>">
        
                        <div class="edit-movie-grid">
                            <div class="edit-movie-field movie-title-field">
                                <span class="summary-label">Movie</span>
                                <span><%= movie.title %></span>
                            </div>
        
                            <div class="edit-movie-field">
                                <label class="summary-label" for="watchStatus-<%= movie.watchlistId %>">Status</label>
                                <select id="watchStatus-<%= movie.watchlistId %>" name="watchStatus">
                                    <option value="Want to Watch" <%= movie.watchStatus === 'Want to Watch' ? 'selected' : '' %>>
                                        Want to Watch
                                    </option>
                                    <option value="Watched" <%= movie.watchStatus === 'Watched' ? 'selected' : '' %>>
                                        Watched
                                    </option>
                                </select>
                            </div>
        
                            <div class="edit-movie-field">
                                <label class="summary-label" for="rating-<%= movie.watchlistId %>">Rating</label>
                                <input
                                    id="rating-<%= movie.watchlistId %>"
                                    type="number"
                                    name="rating"
                                    min="1"
                                    max="10"
                                    value="<%= movie.rating ?? '' %>"
                                    placeholder="Not rated"
                                >
                            </div>
        
                            <div class="edit-movie-field genre-field">
                                <span class="summary-label">Genre</span>
                                <span><%= movie.genre || 'No genre listed' %></span>
                            </div>
        
                            <div class="edit-movie-actions">
                                <button type="submit">Update Movie</button>
                            </div>
                        </div>
                    </form>
        
                    <form action="/updateProfile" method="POST" class="remove-movie-form">
                        <input type="hidden" name="action" value="deleteMovie">
                        <input type="hidden" name="watchlistId" value="<%= movie.watchlistId %>">
        
                        <button type="submit" class="danger-btn">Remove from Watchlist</button>
                    </form>
                </div>
            <% } %>
        </div>

        <div style="margin-top: 24px;">
            <a href="/deleteProfile" class="btn danger-btn">Delete Account</a>
        </div>
    </div>

    <%- include('partials/footer.ejs') %>
</body>
</html>